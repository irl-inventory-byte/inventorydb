# Copy to .env.local and fill in. Never commit .env.local.

# Where the inventory is kept: "supabase", "sheets" (old) or "memory" (default, resets on restart)
STORE=supabase

# Needed when STORE=supabase (Supabase → Project Settings → API). The secret key is SERVER ONLY.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google service account. ALWAYS needed: Add item reads the SD card, mobile and rig lookup sheets live
# from Google, even when the inventory is in Supabase. Share all three sheets with this email as Viewer.
# Check them with: npm run check:sheets
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key from the service account JSON, keep the \n sequences, wrap in quotes
GOOGLE_PRIVATE_KEY=

# Lookup sheets. Leave blank to use the built-in sheets:
#   SD cards  1F2zgaWRgG6WejOJoux-ZFrjkK6xodWoy08Gwdo2-EDI  (every tab with an "Asset Tag" heading)
#   Mobiles   1htZCwR4v7Vdz27P0Rs3ehOzxwwHpfqP_HWu8_KS1L7k
#   Rigs      18AtMF3kPGccxoBMKBzgSoyBalX-x9E_EYPFrtm7ttZU
ASSET_SHEET_ID=
ASSET_SHEET_TABS=
MOBILE_SHEET_ID=
MOBILE_SHEET_TAB=
RIG_SHEET_ID=
RIG_SHEET_TAB=

# Only for STORE=sheets, or to copy the old inventory sheet to Supabase without a downloaded file
SHEET_ID=

# Auth.js (Google sign-in). Generate the secret with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
