# Copy to .env.local and fill in. Never commit .env.local.

# "memory" (default, data resets on restart), "sheets" or "supabase"
STORE=memory

# Needed when STORE=sheets
SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key from the service account JSON, keep the \n sequences, wrap in quotes
GOOGLE_PRIVATE_KEY=

# Optional: a separate reference sheet of asset details, keyed by Asset Tag (= our serial),
# shared with the service account as a Viewer. Used to auto-fill Add a card. Leave blank to skip.
ASSET_SHEET_ID=

# Auth.js (Google sign-in). Generate the secret with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Needed when STORE=supabase (Supabase → Project Settings → API). The secret key is SERVER ONLY.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
